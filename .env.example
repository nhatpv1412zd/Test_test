# Model used for inference (absolute or relative to the project root).
MODEL_PATH=weights/best.pt

# EasyOCR
OCR_LANGUAGES=en
OCR_USE_GPU=false
OCR_ALLOWLIST=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-.
OCR_UPSCALE=2

# Detection -> OCR filtering / preprocessing
OCR_MIN_CONFIDENCE=0.25
PLATE_CLASS_IDS=0
CROP_PADDING=0.1
OCR_USE_CLAHE=true
OCR_USE_BILATERAL=false
OCR_USE_DESKEW=true
OCR_TWO_LINE_ASPECT=1.9
OCR_SPLIT_TWO_LINE=true

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=*

# Training defaults
TRAIN_MODEL=yolov8n.pt
TRAIN_EPOCHS=50
TRAIN_IMGSZ=640
TRAIN_BATCH=8
TRAIN_DEVICE=cpu
